{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimir-marketing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "mimir.himelz.studio",
      "custom_domain": true,
    },
  ],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },
  "services": [
    {
      // Lets the worker call itself for revalidation without a public hop.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mimir-marketing",
    },
  ],
  "ratelimits": [
    {
      // Durable burst cap for /api/feedback. The route also keeps a per-hour
      // in-process budget, but that is per-isolate on Workers and so cannot
      // stop a flood on its own; this is account-level state. `period` accepts
      // only 10 or 60, hence a per-minute cap rather than the hourly one.
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  // Secrets (wrangler secret put): RESEND_API_KEY, RESEND_INBOUND_API_KEY,
  // RESEND_WEBHOOK_SECRET, MIMIR_FEEDBACK_* addresses, GITHUB_TOKEN.
}
